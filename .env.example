# API keys can be provided via environment variables for development.
# In the packaged app, configure them in Settings — they are stored encrypted
# with Electron safeStorage (DPAPI on Windows).

# Google Gemini API key (diagnosis) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# DeepSeek API key (fix-script generation) — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-2.0-flash
DEEPSEEK_MODEL=deepseek-chat
